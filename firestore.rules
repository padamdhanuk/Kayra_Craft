rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSeller() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(['displayName', 'location', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.updatedAt is timestamp
        && (!('location' in data)
          || (data.location is string && data.location.size() <= 80));
    }

    function validListing(data) {
      return data.keys().hasOnly([
          'ownerId',
          'details',
          'price',
          'condition',
          'area',
          'imageUrl',
          'createdAt',
          'status',
          'contactPhone',
          'contactVisible'
        ])
        && data.keys().hasAll([
          'ownerId',
          'details',
          'imageUrl',
          'createdAt'
        ])
        && data.details is string
        && data.details.size() >= 5
        && data.details.size() <= 160
        && (!('price' in data) || (data.price is int && data.price > 0))
        && (!('condition' in data)
          || (data.condition is string
            && data.condition.size() > 0
            && data.condition.size() <= 32))
        && (!('area' in data)
          || (data.area is string
            && data.area.size() >= 2
            && data.area.size() <= 80))
        && data.imageUrl is string
        && data.createdAt is timestamp
        && (!('status' in data)
          || data.status in ['available', 'sold'])
        && (!('contactVisible' in data)
          || (data.contactVisible is bool
            && (!data.contactVisible
              || ('contactPhone' in data
                && data.contactPhone is string
                && data.contactPhone.matches('^\\+[1-9][0-9]{7,14}$')))))
        && (!('contactPhone' in data)
          || ('contactVisible' in data
            && data.contactVisible == true
            && data.contactPhone is string
            && data.contactPhone.matches('^\\+[1-9][0-9]{7,14}$')));
    }

    match /furniture_listings/{listingId} {
      allow read: if true;
      allow create: if isSeller()
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'details',
          'price',
          'condition',
          'area',
          'imageUrl',
          'createdAt',
          'status',
          'contactPhone',
          'contactVisible'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId',
          'details',
          'price',
          'condition',
          'area',
          'imageUrl',
          'createdAt',
          'status',
          'contactVisible'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'available'
        && validListing(request.resource.data);
      allow update: if isSeller()
        && resource.data.ownerId == request.auth.uid
        && validListing(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSeller()
        && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if isSeller()
        && request.auth.uid == userId
        && validUserProfile(request.resource.data);
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
